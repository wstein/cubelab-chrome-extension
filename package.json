{
  "name": "cubelab-linker",
  "version": "0.2.2",
  "description": "Chrome extension that links cube notation on web pages to CubeLab",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wstein/cubelab-chrome-extension.git"
  },
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=detector.js --test-coverage-lines=100 --test-coverage-branches=93 --test-coverage-functions=100 tests/detector.test.cjs tests/sse.test.cjs",
    "test:detector": "node --test tests/detector.test.cjs tests/sse.test.cjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6"
  }
}
